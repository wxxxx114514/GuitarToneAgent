# ---- uv / venv ----
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# ---- uv 缓存 ----
.uv-cache/
uv_cache/
.cache/

# ---- 运行时产物（跑 make_send.py / do_reamp.ps1 会生成）----
*.wav
*.flac
*.mp3
*.mo.part

# ---- 临时 ----
*.tmp
~$*

# ★ 保留（故意不忽略）：
#   reference/*.md      18 份文档
#   tools/  8 个工具（4 驱动 + 4 分轨）
#   models/MANIFEST.json *.yaml   模型来源与配置（权重不进）
#   pyproject.toml uv.lock  环境定义
models/*.ckpt
models/*.pth
models/*.onnx
models/*.part

# ---- 本地环境 / 工具（不进仓库 —— 各人自己的，不是 skill 的一部分）----
python/
ffmpeg/
_env/
_tmp*/

# ★ 注意：这些是【跑起来才需要】的本地目录；
#   uv sync 会重建 .venv；分轨模型靠 dl_bsr.py 下
